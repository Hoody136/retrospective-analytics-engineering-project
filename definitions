   (COALESCE(SAFE_CAST(s.`Lineitem price` AS FLOAT64), p.gbp_rrp) * SAFE_CAST(s.`Lineitem quantity` AS INT64))
       - SAFE_CAST(s.`Subtotal` AS FLOAT64) AS lineitem_discount,


   -- 5. The Liquidation OPEX
   -- Pulling from your custom column in the raw data with exact CSV spelling
   SAFE_CAST(s.`Lineitem Additional Sample Sale Execution Costs` AS FLOAT64) AS execution_cost_gbp


